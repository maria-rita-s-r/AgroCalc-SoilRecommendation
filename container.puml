@startuml

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_TOP_DOWN()

title Diagrama de Contêiner - AgroCalc

Person(produtor, "Produtor Rural", "Utiliza o sistema para cadastrar laudos de solo e consultar recomendações.")

System_Boundary(agrocalc, "AgroCalc - Sistema de Recomendação Agrícola") {

    Container(frontend, "Interface Web", "HTML5, Tailwind CSS, JavaScript", "Permite cadastrar laudos de solo e visualizar recomendações e relatórios.")

    Container(backend, "API Backend", "Python / Flask", "Processa as regras de negócio, realiza os cálculos de calagem e adubação e gerencia o CRUD.")

    ContainerDb(database, "Banco de Dados", "SQLite", "Armazena produtores, laudos de solo e recomendações.")
}

Rel(produtor, frontend, "Utiliza", "HTTPS")
Rel(frontend, backend, "Envia requisições", "HTTP/REST")
Rel(backend, database, "Lê e grava dados", "SQL")

@enduml